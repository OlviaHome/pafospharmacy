# Required in production. Both may be absent only for the local-development/test snapshot fallback.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Trusted ingestion script only. Never expose this value to browser code.
# Required only when running: npm run ingest:official -- --write-supabase
SUPABASE_SECRET_KEY=

# Server-only Geoapify key for manual location search and trusted coordinate enrichment.
# Create a free key at https://myprojects.geoapify.com/. Never use NEXT_PUBLIC_ here.
GEOAPIFY_API_KEY=

# Server-only Upstash Redis credentials for distributed manual-search limits.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Server-only random secret used to HMAC client IPs before Redis sees them.
# Use at least 32 random bytes and never use NEXT_PUBLIC_ here.
LOCATION_SEARCH_HMAC_SECRET=

# Server-only Google Places API (New) key for Paphos reconciliation and refresh.
# Never use NEXT_PUBLIC_. Google response content is an expiring local/database cache.
GOOGLE_PLACES_API_KEY=

# Optional canonical origin for absolute metadata URLs.
SITE_URL=http://localhost:3000

# Blog editorial bot (Telegram + OpenAI). All server-only; never prefix with NEXT_PUBLIC_.
# Bot token from @BotFather and the numeric Telegram user id of the only person the bot obeys.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_ID=
# 16–256 characters of A–Z, a–z, 0–9, _ or -. Telegram sends it back in every webhook call.
TELEGRAM_WEBHOOK_SECRET=
OPENAI_API_KEY=
# Optional. Defaults to gpt-5.6-terra.
OPENAI_MODEL=
# Optional Unsplash access key; without it stock photos come from Openverse (no key needed).
UNSPLASH_ACCESS_KEY=
# Optional limits (defaults shown).
BLOG_MONTHLY_BUDGET_USD=10
BLOG_DAILY_ARTICLE_LIMIT=5
BLOG_DAILY_JOB_LIMIT=40
BLOG_MAX_PARALLEL_JOBS=3
BLOG_MAX_SEARCHES_PER_ARTICLE=8
# Key for opening https://<site>/api/telegram/setup?key=... in a browser (16+ characters).
# Without it, setup works only with "Authorization: Bearer <TELEGRAM_WEBHOOK_SECRET>".
TELEGRAM_SETUP_KEY=
